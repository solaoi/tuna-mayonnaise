{
  "name": "tuna-mayonnaise-ui",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "keywords": [],
  "license": "MIT",
  "engines": {
    "node": "18",
    "npm": ">=8.3"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "file-saver": "^2.0.5",
    "handlebars": "^4.7.8",
    "js-sql-parser": "1.6.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hot-toast": "2.5.2",
    "react-modal": "3.16.3",
    "regenerator-runtime": "0.14.1",
    "rete": "2.0.5",
    "rete-area-plugin": "2.1.3",
    "rete-auto-arrange-plugin": "^2.0.2",
    "rete-connection-path-plugin": "^2.0.4",
    "rete-connection-plugin": "2.0.5",
    "rete-connection-reroute-plugin": "^2.0.3",
    "rete-context-menu-plugin": "^2.0.6",
    "rete-history-plugin": "^2.1.0",
    "rete-minimap-plugin": "^2.0.3",
    "rete-react-render-plugin": "0.3.1",
    "use-interval": "1.4.0"
  },
  "devDependencies": {
    "@types/pug": "2.0.10",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "@types/react-modal": "3.16.3",
    "@vitejs/plugin-react": "4.4.0",
    "eslint": "9.24.0",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "10.1.2",
    "eslint-plugin-import": "2.31.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.1",
    "prettier": "3.5.3",
    "rollup-plugin-visualizer": "5.14.0",
    "stylelint": "16.18.0",
    "stylelint-config-prettier": "9.0.5",
    "stylelint-config-recommended": "16.0.0",
    "stylelint-order": "6.0.4",
    "stylelint-prettier": "5.0.3",
    "typescript": "5.8.3",
    "vite": "6.2.6",
    "vite-plugin-externals": "0.6.2"
  },
  "overrides": {
    "rete-context-menu-plugin": {
      "lodash-es": "4.17.21"
    }
  },
  "scripts": {
    "prepare": "cd .. && husky install ui/.husky",
    "lint:css": "stylelint --fix src/**/*.css",
    "lint:js": "eslint --fix src/**/*.{js,jsx}",
    "format:js": "prettier --write src/**/*.{js,jsx}",
    "fix": "npm run format:js && npm run lint:js && npm run lint:css",
    "dev": "vite",
    "vite-build": "vite build",
    "build": "npm run vite-build && rm -rf ../command/cmd/static/* && mv dist/* ../command/cmd/static/ && touch ../command/cmd/static/.gitkeep && cd ../command/ && go build -o ../tuna && cd ../ui/",
    "build:win": "npm run vite-build && rm -rf ../command/cmd/static/* && mv dist/* ../command/cmd/static/ && touch ../command/cmd/static/.gitkeep && cd ../command/ && GOOS=windows GOARCH=amd64 go build -o ../tuna.exe && cd ../ui/",
    "analyze": "vite build --mode analyze",
    "typecheck": "tsc"
  },
  "lint-staged": {
    "*.css": "stylelint --fix",
    "*.{js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
